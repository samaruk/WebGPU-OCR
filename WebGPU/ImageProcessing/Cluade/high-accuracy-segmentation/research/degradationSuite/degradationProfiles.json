      { "type": "gaussianBlur",     "sigma": 2.0 },
      { "type": "saltPepper",       "density": 0.015 },
      { "type": "reduceBrightness", "factor": 0.70 },
      { "type": "addNoise",         "sigma": 0.08 }
    ]
  },
  "aged_doc": {
    "description": "Aged paper document: yellowing, staining, ink bleed, physical damage",
    "operations": [
      { "type": "gaussianBlur",     "sigma": 1.5 },
      { "type": "addNoise",         "sigma": 0.05 },
      { "type": "reduceBrightness", "factor": 0.82 },
      { "type": "saltPepper",       "density": 0.004 },
      { "type": "jpegArtifacts",    "quality": 80 }
    ]
  }
